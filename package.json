{
  "name": "meetpilot-ai",
  "version": "1.0.0",
  "description": "Consent-first Windows technical meeting copilot",
  "author": "MeetPilot AI",
  "private": true,
  "main": "out/main/index.js",
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src tests scripts docs README.md *.json *.ts *.mts *.mjs *.yml",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "format:check": "prettier --check src tests scripts docs README.md *.json *.ts *.mts *.mjs *.yml",
    "postinstall": "node node_modules/electron/install.js",
    "build:win:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.80.0",
    "openai": "7.64.0",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.17.0",
    "tailwind-merge": "3.7.1",
    "ws": "8.23.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.16.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
